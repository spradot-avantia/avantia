# Variables para el deploy de DEV en Vercel (entorno "Preview", rama dev).
# Cargar en Vercel > Settings > Environment Variables marcando SOLO "Preview"
# (y la rama dev si se quiere), para no pisar Production. Nunca commitear valores reales.
# La referencia general sigue siendo .env.example.

# ── Base de datos: proyecto de Supabase APARTE del productivo (obligatorio) ──
# Crear un proyecto "avantia-dev", aplicar db/schema.sql y db/migrations/ en orden
# y crear el bucket privado "materiales" (archivos de las lecciones).
# Sin esto, el deploy de dev escribe datos de prueba en la base de producción.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# En Supabase > Auth > URL Configuration: Site URL = la URL de dev, y agregar a
# Redirect URLs: <URL de dev>/auth/callback y <URL de dev>/auth/confirm.
# Si se usa Google: agregar el callback de dev en Google Cloud.

# ── Hosts: cómo se separan panel y academias ──
# Panel y landing en el mismo host (ADR 012). Un host que no esté en esta lista se
# trata como academia y el panel deja de abrir.
# El host de la plataforma es www.dev.goavantia.com (el que está asignado a la rama dev en
# Vercel). dev.goavantia.com sin "www" NO está agregado y lo atiende el comodín de producción.
PLATFORM_HOSTS=www.dev.goavantia.com
NEXT_PUBLIC_PANEL_URL=https://www.dev.goavantia.com
NEXT_PUBLIC_SITE_URL=https://www.dev.goavantia.com
# Las academias se resuelven por subdominio (<subdominio>.<raíz>): requiere un dominio
# con comodín (*.dev.goavantia.com) agregado en Vercel. Con URLs *.vercel.app solo se
# prueban panel y landing, no el sitio del alumno.
NEXT_PUBLIC_ROOT_DOMAIN=dev.goavantia.com
# Los despliegues de Preview no se indexan: robots.txt cerrado y X-Robots-Tag noindex (ADR 037).
# La protección de despliegues de Vercel (Vercel Authentication) es una capa aparte.

# ── Acceso ──
# Correos que arrancan como equipo (admin) en la base de dev, que parte vacía.
STAFF_EMAILS=
# Permite crear cuentas de creador sin postulación (solo desarrollo y pruebas).
REGISTRO_ABIERTO=true
# NO definir DEMO_TENANT_SLUG ni activar ALLOW_DEMO_TENANT en un deploy público.

# ── Servicios externos (opcionales; usar credenciales de PRUEBA) ──
# Mercado Pago: token de pruebas (TEST-...). El webhook debe apuntar a la URL de dev.
MERCADOPAGO_ACCESS_TOKEN=
# Resend: sin estas dos variables los correos no salen. Para probar, un destinatario propio.
RESEND_API_KEY=
MAIL_FROM=
POSTULACIONES_NOTIFY_TO=
# Reserva de reuniones de la landing y /postular (vacío = enlace a un correo).
NEXT_PUBLIC_AGENDA_URL=
