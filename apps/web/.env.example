# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pagos
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=

# IA
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Hostname (sufijo) que identifica al panel interno vs. los sitios públicos
# de cada academia. Ej: en producción, app.avantia.app es el panel; cualquier
# otro hostname se resuelve como sitio público de un tenant.
PANEL_HOST_SUFFIX=app.avantia.app

# Tenant fijo que usa la página de admin de dominio (por academia) mientras
# no hay login: en vez de derivar el tenant de una sesión, opera siempre
# sobre el subdomain indicado acá. Ver Supuestos_y_Pendientes.md.
DEMO_TENANT_SLUG=
