# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pagos
# Opcional hasta activar cobros.
MERCADOPAGO_ACCESS_TOKEN=

# IA
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Hostname (sufijo) que identifica al panel interno vs. los sitios públicos
# de cada academia. Ej: en producción, app.avantia.app es el panel; cualquier
# otro hostname se resuelve como sitio público de un tenant.
PANEL_HOST_SUFFIX=app.avantia.app

# Hosts (separados por coma) que sirven la landing en "/".
MARKETING_HOSTS=avantia.app,www.avantia.app
# En local: MARKETING_HOSTS=127.0.0.1 -> http://127.0.0.1:3000 sirve la landing y
# http://localhost:3000 el panel (misma separacion que produccion).

# SOLO desarrollo local: tenant fijo para trabajar sin iniciar sesión. Se ignora
# a menos que ALLOW_DEMO_TENANT=true. NUNCA activar en producción.
DEMO_TENANT_SLUG=
ALLOW_DEMO_TENANT=false

# URL base del panel (login/registro del creador). La landing enlaza aquí.
# Producción: https://app.avantia.app
NEXT_PUBLIC_PANEL_URL=http://localhost:3000

# Correos (separados por coma) que arrancan como equipo de Avantia: se siembran en la tabla
# staff al ingresar; despues el equipo se gestiona en /admin/equipo (ADR 016). Vacio = nadie.
STAFF_EMAILS=

# Dominio raiz para armar el enlace publico de los cursos (<subdominio>.<root>).
NEXT_PUBLIC_ROOT_DOMAIN=avantia.app

# Página de reservas de Google Calendar ("Agenda de citas") para la reunión de
# 20 minutos de la landing y de /postular. Ej: https://calendar.app.google/XXXX
# Vacío = el enlace cae a un correo a contacto@goavantia.com.
NEXT_PUBLIC_AGENDA_URL=
# Host único (ADR 012): landing y panel en el mismo dominio. Si se define, la URL
# del panel es el mismo dominio (NEXT_PUBLIC_PANEL_URL=https://goavantia.com).
# PLATFORM_HOSTS=goavantia.com,www.goavantia.com
# Correo (ADR 014): aviso de postulaciones nuevas e invitación al aceptar. Resend (resend.com);
# hay que verificar goavantia.com en Resend (registros DNS) para enviar desde ese dominio.
# RESEND_API_KEY=
# MAIL_FROM=Avantia <contacto@goavantia.com>
# POSTULACIONES_NOTIFY_TO=javiera@goavantia.com,contacto@goavantia.com
# Registro de creadores solo por invitación; REGISTRO_ABIERTO=true lo abre (desarrollo/pruebas).
# REGISTRO_ABIERTO=true
